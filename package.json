{
  "name": "scintilla",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "scintilla": "./dist/cli/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "benchmarks:list": "node dist/cli/index.js benchmarks list",
    "candidates:validate": "node dist/cli/index.js candidates validate",
    "candidates:evaluate": "node dist/cli/index.js candidates evaluate",
    "examples:list": "node dist/cli/index.js examples list"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
