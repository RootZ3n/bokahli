# Bokahli v2 — API and chat UI.
#
# Binds loopback and Mushin's Tailscale address only. Wildcard binds are
# rejected by the process itself at startup, not merely omitted here.
[Unit]
Description=Bokahli v2 — local AI platform API and chat UI
Documentation=file:/home/zen/repos/bokahli/README.md
After=network-online.target bokahli-runtime.service
Wants=network-online.target
#
# Wants=, deliberately not Requires=.
#
# Requires= made a backend crash take the API layer down with it. Bokahli is the
# authority for runtime health, and an authority that disappears exactly when the
# thing it reports on fails is not an authority at all: callers got a connection
# refused instead of a typed answer, /health/live went dark, and the API paid its
# ~11 s startup digest verification again on the way back — turning a ~7 s backend
# restart into ~18 s of total unavailability.
#
# Wants= keeps what was actually wanted (start the runtime alongside us) and drops
# what was not (die with it). Ordering is still enforced by After=, so a cold boot
# still starts the runtime first and Bokahli attests a loaded model on its first
# probe. When the runtime is gone, Bokahli stays up and returns a typed
# ESCALATE / RUNTIME_UNHEALTHY, and resumes routing on its own once the runtime
# returns and its exact identity is re-attested — no API restart involved.
Wants=bokahli-runtime.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# shared.env is deliberately NOT loaded here any more.
#
# Its only variable is BOKAHLI_RUNTIME_API_KEY, and the server now reads that
# key from ~/.config/bokahli/runtime-api-key (mode 0600) at startup — the same
# file bokahli-runtime.service passes with --api-key-file. Loading it here put
# the secret in this process's environ for no reason: /proc/<pid>/environ is
# mode 400 so it was never a disclosure, but a secret a process does not need
# to hold is one it should not hold, and the deployment contract requires the
# runtime key to be absent from both arguments and environment.
#
# The server still falls back to the environment when the file is unreadable,
# so an un-updated deployment keeps working — and logs a warning saying so.
EnvironmentFile=%h/.config/bokahli/bokahli.env
WorkingDirectory=/home/zen/repos/bokahli
ExecStart=/home/zen/.local/bin/node /home/zen/repos/bokahli/packages/server/dist/main.js

Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bokahli

NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
