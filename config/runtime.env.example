# Bokahli inference runtime — explicit settings, no defaults relied upon.
# Installed to ~/.config/bokahli/runtime.env
BOKAHLI_MODEL_PATH=/home/zen/models/Qwen_Qwen3.5-35B-A3B-Q2_K.gguf
BOKAHLI_MODEL_ALIAS=qwen3.5-35b-a3b.q2-k
BOKAHLI_RUNTIME_PORT=8081
# Context size chosen from measurement, not from the model's 262144 train context.
# See docs/phase1/measurements/context-tiers.md
BOKAHLI_CTX=32768
# One loaded model, one inference slot, one active request.
BOKAHLI_SLOTS=1

# Refuse to start unless CUDA is genuinely usable and the model actually lands
# on the GPU. Set to 0 only to serve on CPU deliberately: a CPU-only load serves
# the correct artifact and attests correctly at roughly a third of the decode
# rate, so nothing downstream can detect it. See scripts/require-gpu.sh.
BOKAHLI_REQUIRE_GPU=1
# How long the precondition waits for the CUDA stack before failing the unit.
BOKAHLI_GPU_WAIT_SECONDS=90
