# Shared between bokahli-runtime.service and bokahli.service.
# The inference backend is loopback-only, but loopback is reachable from any
# browser page running on this machine and llama-server sets CORS to '*'.
# This key closes that path: the backend requires it even over 127.0.0.1.
# Generated by scripts/install-units.sh. Keep 0600.
BOKAHLI_RUNTIME_API_KEY=REPLACE_ME
