# Bokahli API + chat UI. Installed to ~/.config/bokahli/bokahli.env
# Loopback + Mushin's Tailscale address. 0.0.0.0 is rejected at startup.
BOKAHLI_BIND=127.0.0.1,100.115.140.2
BOKAHLI_PORT=8080
BOKAHLI_CATALOG=/home/zen/repos/bokahli/catalog/artifacts.json
BOKAHLI_PUBLIC_DIR=/home/zen/repos/bokahli/packages/server/public
BOKAHLI_TOKEN_PATH=/home/zen/.config/bokahli/token
BOKAHLI_MAX_CONCURRENT=1
BOKAHLI_MAX_QUEUE_DEPTH=8
BOKAHLI_QUEUE_TIMEOUT_MS=180000
# Prompt and completion text never enters the log unless this is set to 1.
BOKAHLI_LOG_PROMPTS=0
# Recompute the artifact sha256 at startup (~7s for a 12.6 GiB artifact).
BOKAHLI_VERIFY_DIGEST=1
# VRAM a foreign compute process must hold to count as a GPU lease holder.
# Measured desktop baseline on Mushin is ~785 MiB across all display processes.
BOKAHLI_GPU_FOREIGN_THRESHOLD_MIB=512
